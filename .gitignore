# ==========================================
# Archivos de compilación y salida de Java / Ant
# ==========================================
*.class
/build/
/dist/
/nbbuild/
/nbdist/
/classes/

# Excluir archivos empaquetados pero permitir dependencias en conector/ o lib/
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
!conector/*.jar
!lib/*.jar

# ==========================================
# NetBeans IDE
# ==========================================
**/nbproject/private/
**/nbproject/Makefile-*.mk
**/nbproject/Package-*.bash
.nb-gradle/

# ==========================================
# Otros IDEs (IntelliJ IDEA, Eclipse, VS Code)
# ==========================================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/

# Visual Studio Code
.vscode/
*.code-workspace

# ==========================================
# Archivos de depuración y logs de JVM
# ==========================================
*.log
hs_err_pid*
replay_pid*

# ==========================================
# Archivos del Sistema Operativo
# ==========================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
